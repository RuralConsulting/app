  "ask": [
    {"match": ["mark", "done"], "reply": {"answer_text": "The first FEP audit is still open. If it has been done, confirm it below.", "sources": [{"kind": "obligation", "id": "obl-audit", "label": "Have the first FEP audit done · due 14 Jan 2026 · no record"}], "ui_actions": [], "confirmations": [{"verb": "obligation.done", "obligation_id": "obl-audit", "label": "Mark done: condition 8a: Have the first FEP audit done"}], "notes": []}},
    {"match": ["audit"], "reply": {"answer_text": "Three things stand before the audit:\n- Have the first FEP audit done: it was due 14 Jan 2026 and there is no record of it yet.\n- Keep the base year input records ready for the auditor.\n- The FEP must hold the property details, the maps and the list of consents.\nAfter the first audit, the farm is audited again on the timeframe its grade sets.", "sources": [{"kind": "obligation", "id": "obl-audit", "label": "Have the first FEP audit done · due 14 Jan 2026 · no record"}, {"kind": "obligation", "id": "obl-inputs", "label": "Keep records of the base year inputs, for the auditor on request"}, {"kind": "obligation", "id": "obl-fep-b1", "label": "Property details and the farm's identifier"}, {"kind": "obligation", "id": "obl-fep-b2", "label": "Maps of boundaries, land units, waterways and crossings"}, {"kind": "obligation", "id": "obl-fep-b3", "label": "A list of the consents held"}, {"kind": "obligation", "id": "obl-reaudit", "label": "Have the farm audited again on the timeframe its last grade sets · no record"}], "ui_actions": [{"verb": "map.layers", "set": "fep"}, {"verb": "map.frame", "place": "farm"}], "confirmations": [], "notes": []}},
    {"match": ["action"], "reply": {"answer_text": "No actions from the FEP are mapped or recorded on this farm yet: there is no proposed fences layer and no actions list. The plan itself is the Farm Environment Plan 2024.", "sources": [{"kind": "document", "id": "doc-fep", "label": "Farm Environment Plan 2024 (synthetic)"}], "ui_actions": [{"verb": "map.layers", "set": "fep"}, {"verb": "map.frame", "place": "farm"}], "confirmations": [], "notes": []}},
    {"match": ["drain"], "reply": {"answer_text": "The farm's own waterways layer has a creek and a drain. The nearest downstream monitoring site is Demo Creek at the Mill Road ford (synthetic), 2.4 km down the REC2 river network; LAWA's latest state there puts nitrate (toxicity) in band B (hYear 2025), and LAWA's 10-year nitrate trend is likely degrading. The Hurunui context module assembled those facts; they are shown below. Not held yet:\n- the river network on the farm and the river it joins\n- the CWMS zone and catchment", "sources": [{"kind": "obligation", "id": "obl-winter", "label": "Keep winter grazing at least 5 m from waterways and drains"}], "ui_actions": [{"verb": "map.layers", "set": "water"}, {"verb": "map.frame", "place": "layer:waterways"}], "confirmations": [], "notes": [], "drains_to": {"author": "Hurunui context module v1", "module": {"key": "hurunui", "name": "Hurunui context module", "version": "1"}, "site_status": "found", "site_message": null, "max_km": 25, "site": {"monitoring_site_id": 9102, "source_key": "ecan-wq-sites", "external_id": "DEMO-02", "name": "Demo Creek at the Mill Road ford (synthetic)", "distance_km_along": 2.437}, "lawa": {"status": "state", "message": null, "lawa_site_id": "DEMO-LAWA-02", "release": "27oct2026", "release_date": "27 Oct 2026", "attribution": "Invented demo values in the shape of LAWA's results (in use: Data sourced from LAWA (Land, Air, Water Aotearoa) and Environment Canterbury.)", "state": [{"attribute": "Dissolved reactive phosphorus (synthetic)", "band": "C", "period": "hYear 2025"}, {"attribute": "Nitrate (toxicity) (synthetic)", "band": "B", "period": "hYear 2025"}], "trend": [{"indicator": "Nitrate nitrogen (synthetic)", "description": "Likely degrading", "period": "10 years"}]}}}},
    {"match": ["neighbour", "next door"], "reply": {"answer_text": "The steps for adding the new land are open on the map: tap the parcels that are now the farm's, then save. Nothing is saved until you do.", "sources": [], "ui_actions": [{"verb": "block.add"}], "confirmations": [], "notes": []}},
    {"match": ["water quality"], "reply": {"answer_text": "The platform calculated the nitrate toxicity band for the ECan site downstream of the farm: band B over the five years to June 2025, from 60 monthly values. Band B means some growth effect on up to 5% of species. ECan's results are provisional, and four results were below the detection limit (shown as ranges where that matters). The figures are in the card below; confirm it to record it for the farm.", "sources": [], "ui_actions": [], "confirmations": [], "analyses": [{"tool": "band", "tool_version": "x1-wq 1.0.0", "parameters": {"tool": "band", "site_id": 1, "attribute": "nitrate-toxicity", "end_year": 2025, "years": 5, "from": "2020-07-01", "to": "2025-06-30", "parameter": "nitrate-n"}, "ai_proposed_inputs": {"tool": "band", "site_id": 1, "attribute": "nitrate-toxicity", "end_year": 2025}, "advisor_overrides": {}, "method": {"id": "x1-band v1", "name": "NPS-FM attribute band: Nitrate (toxicity)", "percentile": "Hazen plotting position, p = (i - 0.5) / n, linear interpolation", "censoring": "censored results as intervals (<L = [0, L], >L = [L, unbounded)); statistics computed at both ends; no substitution", "instrument": "National Policy Statement for Freshwater Management 2020 (amended December 2025), https://environment.govt.nz/assets/publications/npsfm-2020-amended-december-2025.pdf (checked 2026-11-04)", "table": "Appendix 2A Table 6 – Nitrate (toxicity)", "min_record": "54 of 60 months and 18 of 20 quarters over 5 hydrological years (LAWA factsheet: Calculating water quality state for rivers (NOF attribute bands, river monitoring network), https://lawa.org.nz/learn/factsheets/calculating-water-quality-state-for-rivers)"}, "measurement_sources": ["ecan-wq"], "source_versions": {"ecan-wq": {"rows": 60, "last_load_run_id": 3, "max_updated_at": "2026-10-01T00:00:00Z", "rows_sha256": "1975f921ef0ce4e50d3c2ba738d78a21927875fcee218c38237f4102ebca754f"}}, "result": {"attribute": "nitrate-toxicity", "table": "Appendix 2A Table 6 – Nitrate (toxicity)", "band": "B", "statistics": [{"statistic": "median", "label": "Median (5 years of monthly values)", "value": {"lo": 0.9, "hi": 0.9, "exact": true}, "display": "0.9 mg NO3-N/L", "band": "A"}, {"statistic": "p95", "label": "95th percentile (5 years of monthly values)", "value": {"lo": 1.9, "hi": 1.9, "exact": true}, "display": "1.9 mg NO3-N/L", "band": "B"}], "monthly_values": 60, "bottom_line": {"median": 2.4, "p95": 3.5}, "notes": ["Table 6's statistics are an annual median and an annual 95th percentile; as LAWA does, they are calculated over the 5 years of monthly values."], "coverage": {"months": 60, "quarters": 20, "years_with_data": 5, "expected_months": 60, "expected_quarters": 20}}, "unavailable": null, "site": {"monitoring_site_id": 1, "source_key": "ecan-wq-sites", "external_id": "SQ99001", "name": "Cairnvale Stream at Downs Road (synthetic)"}, "attribution": [{"dataset": "ecan-wq", "name": "Surface water quality results (ECan)", "statement": "Source: Environment Canterbury. Results are provisional until reviewed by ECan.", "provisional": "Provisional until reviewed by ECan."}], "caveats": ["Table 6's statistics are an annual median and an annual 95th percentile; as LAWA does, they are calculated over the 5 years of monthly values.", "Surface water quality results (ECan): Provisional until reviewed by ECan.", "The source does not report the laboratory or method of each result, so method comparability is not checked.", "4 samples are below or above a detection limit; statistics are shown as ranges where that matters (nothing is substituted)."], "statement": "Computed by the platform, method x1-band v1 (x1-wq 1.0.0), National Policy Statement for Freshwater Management 2020 (amended December 2025) Appendix 2A Table 6 – Nitrate (toxicity), window 1 Jul 2020 to 30 Jun 2025, Cairnvale Stream at Downs Road (synthetic) (ecan-wq-sites SQ99001): Nitrate (toxicity) attribute band B (median (5 years of monthly values) 0.9 mg NO3-N/L, 95th percentile (5 years of monthly values) 1.9 mg NO3-N/L; 60 monthly values).", "preview_sha256": "e697b2af8fc0cc1e0afbc8f6a5cbaf0f29a1a2fee0383e30315f5c7ea79d5798", "note_allowed": true}], "notes": []}},
